# HyperDataLab SSO public client. Register this exact callback with the SSO provider.
NEXT_PUBLIC_HYPERDATALAB_SSO_BASE_URL=https://rpr-grobid-gateway.hpl-storage.workers.dev
NEXT_PUBLIC_HYPERDATALAB_SSO_CLIENT_ID=register-writing-lab-client
NEXT_PUBLIC_HYPERDATALAB_SSO_CALLBACK_URL=http://localhost:3000/auth/callback
NEXT_PUBLIC_RESEARCH_HUB_URL=https://researchhub.hyperdatalab.org
NEXT_PUBLIC_RESEARCH_HUB_ORIGINS=https://researchhub.hyperdatalab.org,http://localhost:3000

# Cloudflare Worker API. Local Wrangler default: http://localhost:8787
NEXT_PUBLIC_WORKER_API_URL=http://localhost:8787
